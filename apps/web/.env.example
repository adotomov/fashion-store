VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty for local dev to
# keep analytics OFF — no gtag script is injected and all tracking is a no-op.
VITE_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID — a numeric string. Leave empty for local dev to keep
# the Pixel OFF (no fbq script injected, all events no-op). Prod value: 1445134643714482.
VITE_META_PIXEL_ID=
